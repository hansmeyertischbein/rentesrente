---
layout: base.njk
tittel: "Overfør: et trykkespill om aksjer og utbytte"
beskrivelse: Fyll sparegrisen ti øre om gangen, kjøp aksjer som gir utbytte hvert sekund, og bruk boostere når du har råd.
permalink: /spill/overfor/
skript: /assets/js/klikker.js
sideklasse: side-klikk
---
{%- set r = klikkdata.regler -%}
<div class="spillside">
  <h1 class="skjult">Overfør</h1>

  <section class="klikk" id="klikk" aria-labelledby="klikk-tittel">
    <h2 id="klikk-tittel" class="skjult">Spillet</h2>
    <noscript><p class="forbehold">Spillet trenger JavaScript.</p></noscript>

    <div class="utsikt" id="utsikt" aria-hidden="true"><div class="utsikt-rute" id="utsikt-rute"><div class="utsikt-korn" id="utsikt-korn"></div></div></div>

    <div class="klikk-scene" id="scene">
      <div class="profil">
        <button type="button" class="spillikon profil-ikon" id="ikon-knapp" aria-label="Ikonet ditt"></button>
        <span class="spillikon profil-strategi" id="strategi-merke" tabindex="0" role="img" hidden></span>
        <button type="button" class="spillikon profil-gud" id="gud-knapp-topp" aria-label="Gudegriser" hidden><span class="profil-prikk" hidden></span></button>
        <button type="button" class="spillikon profil-pokal" id="prestasjon-knapp" aria-label="Prestasjoner"><span class="ikon-merke" id="prestasjon-antall">0</span></button>
        <button type="button" class="spillikon profil-spill" id="minispill-knapp" aria-label="Minispill"></button>
        <button type="button" class="spillikon profil-tannhjul" id="innstillinger-knapp" aria-label="Innstillinger"></button>
        {% if konto.url and konto.nokkel %}<button type="button" class="profil-logg-inn" id="logg-inn-topp" hidden>Logg inn</button>{% endif %}
        <p class="lotto-merke" id="lotto-merke"></p>
      </div>
      <div class="gris-konto" id="konto">
        <p class="konto-merke">I sparegrisen</p>
        <p class="konto-saldo" id="saldo">0 øre</p>
        <p class="konto-inntekt">Inntekt <b id="inntekt">0 øre/sek</b></p>
        <p class="konto-deler"><span class="inntekt-del del-utbytte">Utbytte <b id="rate">0 øre/sek</b></span> <span class="inntekt-del del-trykk">Trykk siste sekund <b id="klikkrate">0 øre</b></span></p>
      </div>

      <aside class="boostere" aria-labelledby="booster-tittel">
        <h3 class="panel-tittel" id="booster-tittel">Boostere</h3>
        <ul class="ikonliste" id="booster-liste" aria-labelledby="booster-tittel"></ul>
        <h3 class="skjult" id="gf-tittel">Generalforsamling</h3>
        <ul class="ikonliste gf-liste" id="gf-liste" aria-labelledby="gf-tittel" hidden></ul>
      </aside>

      <div class="gris-flate" id="gris-flate">
        <ul class="bobler" id="ventende" aria-label="Investeringer som venter"></ul>
        <button type="button" class="gris" id="overfor"><span class="gris-merke"><span class="gris-navn">Overfør</span> <span class="gris-verdi" id="gris-verdi">+{{ r.trykkStart | ore }}</span></span></button>
        <p class="fart" id="fart"><span id="fart-tekst">Trykk raskt for fart</span><span class="fart-strek" aria-hidden="true"><i id="fart-fyll"></i></span></p>
      </div>

      <div class="uro" id="uro" tabindex="0" role="img" aria-label="Uro i markedet: 0 prosent" aria-describedby="tips">
        <span class="uro-ikon" id="uro-ikon"></span>
        <span class="uro-strek"><i id="uro-fyll"></i></span>
      </div>

      <p class="oppgrader-rad"><button type="button" class="oppgrader" id="oppgrader"><span class="oppgrader-navn">Større overføring <b id="oppgrader-niva">nivå 0</b></span><span class="pris" id="oppgrader-pris">{{ r.trykkGrunnpris | ore }}</span></button></p>

      <div class="meldinger">
        <p class="hendelse" id="hendelse" hidden></p>
        <div class="lotto" id="lotto" role="group" aria-labelledby="lotto-tittel" hidden>
          <p class="lotto-tittel" id="lotto-tittel">Lotto</p>
          <p class="ekstra-vilkar" id="lotto-tekst"></p>
          <div class="lotto-kjop" id="lotto-kjop">
            <label class="lotto-antall"><span class="skjult">Antall rekker</span><input id="lotto-antall" type="number" inputmode="numeric" min="1" max="10000" step="1" value="1"></label>
            <span class="lotto-raske"><button type="button" data-n="1">1</button><button type="button" data-n="10">10</button><button type="button" data-n="100">100</button></span>
            <button type="button" class="oppgrader" id="lotto-knapp"><span class="oppgrader-navn" id="lotto-handling">Kjøp 1 rekke</span><span class="pris" id="lotto-pris"></span></button>
          </div>
          <ol class="lotto-baller" id="lotto-baller" hidden></ol>
          <p class="lotto-resultat" id="lotto-resultat" hidden></p>
        </div>
        <div class="ekstra" id="ekstra" role="group" aria-labelledby="ekstra-navn" hidden>
          <p class="ekstra-navn" id="ekstra-navn">Invester i en av disse</p>
          <p class="ekstra-vilkar" id="ekstra-vilkar"></p>
          <div class="ekstra-valg" id="ekstra-valg"></div>
        </div>
        <p class="status" id="status" role="status"></p>
        <p class="skjult" id="annonse" role="status"></p>
      </div>
    </div>

    <div class="butikk">
      <div class="butikk-hode">
        <h2 id="butikk-tittel">Kjøp aksjer</h2>
        <fieldset class="butikk-antall">
          <legend class="skjult">Hvor mange hvert kjøp gjelder</legend>
          <div class="segment">
            <label><input type="radio" name="antall" value="1" checked><span>1</span></label>
            <label><input type="radio" name="antall" value="10"><span>10</span></label>
            <label><input type="radio" name="antall" value="maks"><span>Maks</span></label>
          </div>
        </fieldset>
      </div>
      <div class="kort strategi-valg" id="strategi-valg" hidden>
        <h3 class="kort-tittel">Velg strategi</h3>
        <p class="kort-info">Du har hatt 1 mill. kr innom grisen. Velg hvordan du vil ta risiko. Valget står til du tar prestisje.</p>
        <div class="strategi-knapper" id="strategi-knapper"></div>
      </div>
      <div class="kort giring" id="giring" hidden>
        <label class="giring-rad" for="giring-skyv"><span class="kort-tittel">Giring</span> <b id="giring-tall">1x</b></label>
        <input type="range" id="giring-skyv" min="0" max="1000" step="1" value="500">
        <p class="kort-info">Du låner til resten av investeringen og obligasjonen. Gevinst og tap ganges med giringen. Taper du mer enn du har, selges aksjene dine for halv pris.</p>
      </div>
      <div class="kort obl" id="obl" hidden>
        <h3 class="kort-tittel">Obligasjoner</h3>
        <p class="kort-info" id="obl-tekst"></p>
        <div class="ekstra-valg" id="obl-valg"></div>
      </div>
      <div class="radgiver" id="radgiver" hidden>
        <span class="radgiver-figur" id="radgiver-figur"></span>
        <div class="radgiver-tekst">
          <p class="radgiver-navn">Investeringsrådgiver <b>Finn Fondsen</b></p>
          <p class="radgiver-info" id="radgiver-info"></p>
        </div>
        <button type="button" class="oppgrader radgiver-knapp" id="radgiver-knapp"><span class="oppgrader-navn" id="radgiver-handling">Ansett</span><span class="pris" id="radgiver-pris"></span></button>
      </div>
      <ul class="butikk-liste" id="butikk" aria-labelledby="butikk-tittel"></ul>

      <div class="kort prestisje" id="prestisje" hidden>
        <h3 class="kort-tittel">Prestisje</h3>
        <p class="kort-info" id="prestisje-tekst"></p>
        <button type="button" class="oppgrader" id="prestisje-knapp" hidden><span class="oppgrader-navn">Ta prestisje</span></button>
      </div>

      <p class="klikk-husk"><label><input type="checkbox" id="husk"> <span>Husk spillet på denne enheten</span></label></p>
      <p class="spill-omstart"><button type="button" class="lenkeknapp" id="omstart">Start på nytt</button> <button type="button" class="lenkeknapp" id="om-spillet">Om spillet</button>{% if konto.url and konto.nokkel %} <button type="button" class="lenkeknapp" id="konto-knapp" hidden>Logg inn</button>{% endif %}</p>
    </div>

  </section>

</div>

<dialog class="spill-intro spill-vindu" id="intro" aria-labelledby="intro-tittel">
  <h2 id="intro-tittel">Overfør</h2>
  <p class="ingress">Hvert trykk på grisen overfører {{ r.trykkStart | ore }}. Kjøp aksjer som gir utbytte hvert sekund, fra limonadeboden på hjørnet til de store selskapene.</p>
  <form method="dialog"><button class="knapp knapp-hoved intro-start" value="start">Start å spille</button></form>
  <h3>Lagring</h3>
  <p>Ingenting lagres før du krysser av for «Husk spillet på denne enheten». Da legges spillet i nettleserens lager på enheten din, og det sendes ikke til oss. Fjerner du krysset, slettes det. Mens siden er lukket, gir aksjene utbytte i inntil {{ r.maksBorteSek | tid }}. <a href="/personvern/">Les mer om personvern</a>.</p>
  <h3>Flytt spillet til en annen enhet</h3>
  <p>Lag en kode her og lim den inn på telefonen eller en annen PC. Koden er hele spillet ditt, så del den bare med deg selv.</p>
  <p class="flytt-knapper"><button type="button" class="oppgrader" id="flytt-lag"><span class="oppgrader-navn">Lag kode</span></button></p>
  <textarea class="flytt-kode" id="flytt-kode" rows="3" readonly hidden aria-label="Koden for spillet ditt"></textarea>
  <label class="flytt-inn"><span>Har du en kode fra en annen enhet?</span><textarea id="flytt-inn" rows="2" autocapitalize="none" autocorrect="off" spellcheck="false"></textarea></label>
  <p class="flytt-knapper"><button type="button" class="oppgrader" id="flytt-hent"><span class="oppgrader-navn">Hent spillet</span></button></p>
  <p class="flytt-status" id="flytt-status" role="status"></p>
  <h3>Les også</h3>
  <ul class="intro-lenker">
    <li><a href="/spill/tjue-ar/">Tjue år</a> Et spill om buffer, fond og regninger, der valgene dine teller.</li>
    <li><a href="/kalkulatorer/renters-rente/">Hvor mye blir sparingen din verdt?</a> Regn med egne beløp, kostnader, skatt og inflasjon.</li>
    <li><a href="/forklart/renters-rente/">Hva er renters rente?</a> Hvorfor tiden betyr mer enn beløpet.</li>
    <li><a href="/ikke-radgivning/">Generell informasjon, ikke personlig rådgivning</a></li>
  </ul>
  <form method="dialog"><button class="intro-lukk" value="lukk" aria-label="Lukk">×</button></form>
</dialog>
<dialog class="spill-intro spill-vindu" id="ikon-vindu" aria-labelledby="ikon-tittel">
  <h2 id="ikon-tittel">Hvem er du?</h2>
  <p class="ingress">Ikonet står øverst til venstre. Det første er gratis. De andre er dyre, og jo kulere, jo dyrere.</p>
  <ul class="ikon-liste" id="ikon-liste"></ul>
  <p class="flytt-status" id="ikon-status" role="status"></p>
  <form method="dialog"><button class="intro-lukk" value="lukk" aria-label="Lukk">×</button></form>
</dialog>
<dialog class="spill-intro spill-vindu gud-vindu" id="gud-vindu" aria-labelledby="gud-tittel">
  <h2 id="gud-tittel">Gudegriser</h2>
  <p class="ingress">Velg én av fire greiner og kjøp gudene i rekkefølge.</p>
  <div class="gud-valgt" id="gud-valgt" aria-live="polite">
    <span class="gud-valgt-bilde" id="gud-valgt-bilde"></span>
    <div class="gud-valgt-tekst">
      <p class="gud-valgt-topp"><span class="gud-tall" id="gud-valgt-tall"></span> <span id="gud-valgt-gren"></span></p>
      <strong id="gud-valgt-navn"></strong>
      <p class="gud-hint" id="gud-valgt-hint"></p>
      <p class="gud-virkning" id="gud-valgt-virkning"></p>
      <small id="gud-valgt-merk"></small>
      <p class="gud-kjop"><button type="button" class="oppgrader" id="gud-vindu-knapp" hidden><span class="oppgrader-navn" id="gud-vindu-handling"></span><span class="pris" id="gud-vindu-pris"></span></button></p>
    </div>
  </div>
  <ul class="gud-grener" id="gud-grener"></ul>
  <form method="dialog"><button class="intro-lukk" value="lukk" aria-label="Lukk">×</button></form>
</dialog>
<dialog class="spill-intro spill-vindu" id="prestasjon-vindu" aria-labelledby="prestasjon-tittel">
  <h2 id="prestasjon-tittel">Prestasjoner</h2>
  <dl class="statistikk" id="statistikk"></dl>
  <ul class="prestasjon-liste" id="prestasjon-liste"></ul>
  <form method="dialog"><button class="intro-lukk" value="lukk" aria-label="Lukk">×</button></form>
</dialog>
<dialog class="spill-intro spill-vindu" id="innstillinger-vindu" aria-labelledby="innstillinger-tittel">
  <h2 id="innstillinger-tittel">Innstillinger</h2>
  {% if konto.url and konto.nokkel %}<section class="innst-del">
    <h3>Konto</h3>
    <p id="innst-konto-tekst">Lag en konto for å spille på telefonen og andre enheter.</p>
    <p class="flytt-knapper"><button type="button" class="oppgrader" id="innst-konto"><span class="oppgrader-navn">Logg inn eller lag konto</span></button></p>
  </section>{% endif %}
  <section class="innst-del">
    <h3>Lyd</h3>
    <label class="bryter-rad"><span>Lydeffekter</span><input type="checkbox" id="lyd-effekter" role="switch"></label>
    <label class="skyv-rad"><span>Volum på effekter</span><input type="range" id="lyd-effekt-volum" min="0" max="100" step="1"></label>
    <label class="bryter-rad"><span>Musikk</span><input type="checkbox" id="lyd-musikk" role="switch"></label>
    <label class="skyv-rad"><span>Volum på musikk</span><input type="range" id="lyd-musikk-volum" min="0" max="100" step="1"></label>
    <p class="kort-info">All lyd lages i nettleseren mens du spiller. Valgene huskes på denne enheten.</p>
  </section>
  <section class="innst-del">
    <h3>Spillet</h3>
    <p class="flytt-knapper"><button type="button" class="lenkeknapp" id="innst-om">Om spillet og flytting med kode</button></p>
  </section>
  <form method="dialog"><button class="intro-lukk" value="lukk" aria-label="Lukk">×</button></form>
</dialog>
<dialog class="spill-intro vakt" id="vakt-vindu" aria-labelledby="vakt-tittel">
  <h2 id="vakt-tittel">Er det du som trykker?</h2>
  <p class="ingress">Trykkene ser automatiske ut.</p>
  <div class="vakt-bane" id="vakt-bane"><button type="button" class="vakt-mynt" id="vakt-mynt" aria-label="Mynt som flytter seg">kr</button></div>
  <p class="flytt-status" id="vakt-status" role="status"></p>
  <p><button type="button" class="lenkeknapp" id="vakt-vent"></button></p>
</dialog>
<dialog class="spill-intro spill-vindu minispill-vindu" id="minispill-vindu" aria-labelledby="minispill-tittel">
  <div class="mini-topp"><button type="button" class="mini-tilbake" id="minispill-tilbake" aria-label="Tilbake" hidden>←</button><h2 id="minispill-tittel">Minispill</h2></div>
  <div id="minispill-rot"></div>
  <form method="dialog"><button class="intro-lukk" value="lukk" aria-label="Lukk">×</button></form>
</dialog>
<div class="himmel" id="himmel"></div>
<div class="prestasjon-toast" id="prestasjon-toast" role="status" hidden></div>
{% if konto.url and konto.nokkel -%}
<dialog class="spill-intro spill-vindu" id="konto-vindu" aria-labelledby="konto-tittel" data-url="{{ konto.url }}" data-nokkel="{{ konto.nokkel }}">
  <h2 id="konto-tittel">Spill på flere enheter</h2>
  <p class="ingress" id="konto-ingress">Med en konto lagres spillet ditt, så du kan fortsette på telefonen eller en annen PC.</p>
  <div class="konto-valg" id="konto-valg">
    <button type="button" class="konto-valg-knapp" id="konto-velg-inn"><b>Logg inn</b><span>Jeg har en konto</span></button>
    <button type="button" class="konto-valg-knapp ny" id="konto-velg-ny"><b>Lag ny konto</b><span>Første gang her</span></button>
  </div>
  <form class="konto-skjema" id="konto-skjema" novalidate hidden>
    <label class="konto-felt"><span>E-post</span><input id="konto-epost" type="email" inputmode="email" autocomplete="email" autocapitalize="none" spellcheck="false" required></label>
    <label class="konto-felt"><span>Passord, minst 8 tegn</span><input id="konto-passord" type="password" autocomplete="current-password" minlength="8" maxlength="72" required></label>
    <p class="flytt-knapper"><button type="submit" class="oppgrader" id="konto-send"><span class="oppgrader-navn" id="konto-send-tekst">Logg inn</span></button> <button type="button" class="lenkeknapp" id="konto-tilbake">Tilbake</button></p>
  </form>
  <div class="konto-venter" id="konto-venter" hidden>
    <p class="konto-venter-tekst" id="konto-venter-tekst"></p>
    <p class="konto-laster" aria-hidden="true"><i></i><i></i><i></i></p>
    <p class="flytt-knapper"><button type="button" class="lenkeknapp" id="konto-send-igjen">Send e-posten på nytt</button> <button type="button" class="lenkeknapp" id="konto-avbryt">Avbryt</button></p>
  </div>
  <div id="konto-innlogget" hidden>
    <p id="konto-hvem"></p>
    <p class="flytt-knapper"><button type="button" class="oppgrader" id="konto-ut"><span class="oppgrader-navn">Logg ut</span></button> <button type="button" class="lenkeknapp" id="konto-slett">Slett kontoen</button></p>
  </div>
  <p class="flytt-status" id="konto-status" role="status"></p>
  <p class="konto-personvern">Vi lagrer e-posten din, et kryptert passord og spillet. Ingenting annet. <a href="/personvern/#kontoer">Les mer om personvern</a>.</p>
  <form method="dialog"><button class="intro-lukk" value="lukk" aria-label="Lukk">×</button></form>
</dialog>
{% endif -%}
<div class="tips" id="tips" role="tooltip" hidden></div>
<div class="mini" id="mini" aria-hidden="true"><span>I grisen <b id="mini-saldo">0 øre</b></span><span>Inntekt <b id="mini-rate">0 øre/sek</b></span></div>
